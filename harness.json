{
  "$comment": "harness v2 (SC-5859) — generated by `harness init`; change the template in ~/Development/harness, never this file",
  "version": 2,
  "stack": "ts-node",
  "tier": "A",
  "defaultBranch": "main",
  "riskPaths": [
    "**/auth/**",
    "**/billing/**",
    "**/payments/**",
    "**/migrations/**",
    "**/*.sql",
    ".env*",
    "**/secrets/**"
  ],
  "checks": {
    "fast": "npm run -s check:fast",
    "full": "npm run -s check:full",
    "ui": "npm run -s check:ui"
  },
  "tests": {
    "runners": [
      {
        "match": "**",
        "cmd": "npx vitest run {files}"
      }
    ]
  },
  "coverage": {
    "lcov": "coverage/lcov.info",
    "diffMin": 80
  },
  "routes": {
    "source": "none"
  },
  "review": {
    "enabled": true,
    "blockOn": "high",
    "maxFixAttempts": 2
  },
  "gapFiller": {
    "enabled": true,
    "maxAttempts": 1
  },
  "ci": {
    "provider": "none",
    "requiredChecks": []
  },
  "hooks": {
    "lint": true,
    "format": true,
    "types": true,
    "tests": true
  }
}
